# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# ─── Google OAuth2 — Tenant 1 (e.g. cloudfuze.us) ────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_1
GOOGLE_CLIENT_SECRET=your_google_client_secret_1

# ─── Google OAuth2 — Tenant 2 (e.g. storefuze.com) ──────────────────────────
GOOGLE_CLIENT_ID_2=your_google_client_id_2
GOOGLE_CLIENT_SECRET_2=your_google_client_secret_2
GOOGLE_TENANT_2_DOMAINS=storefuze.com

# ─── Google OAuth2 — Tenant 3 (e.g. cloudfuze.com) ──────────────────────────
# Redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID_3=your_google_client_id_3
GOOGLE_CLIENT_SECRET_3=your_google_client_secret_3
GOOGLE_TENANT_3_DOMAINS=cloudfuze.com

# ─── Google OAuth2 — Tenant 4 (e.g. filefuze.co — Chat API enabled) ─────────
# Redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID_4=your_google_client_id_4
GOOGLE_CLIENT_SECRET_4=your_google_client_secret_4
GOOGLE_TENANT_4_DOMAINS=filefuze.co

# ─── Google pre-issued refresh tokens ─────────────────────────────────────────
# Format: email1=refresh_token_1,email2=refresh_token_2,...
# Each account is used by GmailTestDataAgent as source/attendee for mail & calendar.
GOOGLE_ACCOUNTS=admin@domain.com=your_refresh_token_here,user@domain.com=your_refresh_token_here

# ─── Microsoft Graph / Azure AD — Tenant 1 (Run Agent: mail + calendar) ──────
GRAPH_CLIENT_ID=your_graph_client_id_1
GRAPH_CLIENT_SECRET=your_graph_client_secret_1
GRAPH_TENANT_ID=your_graph_tenant_id_1

# ─── Microsoft Graph — Message Agent app (Teams delegated permissions) ────────
# Required scopes: Team.ReadBasic.All, Channel.ReadBasic.All, ChannelMessage.Send,
#                  Chat.ReadWrite, ChatMessage.Send
# Redirect URI: http://localhost:5000/api/auth/microsoft/callback
MS_MESSAGE_CLIENT_ID=your_ms_message_client_id
MS_MESSAGE_CLIENT_SECRET=your_ms_message_client_secret

# ─── Microsoft Graph / Azure AD — Tenant 2 (e.g. filefuze.co) ───────────────
GRAPH_CLIENT_ID_2=your_graph_client_id_2
GRAPH_CLIENT_SECRET_2=your_graph_client_secret_2
GRAPH_TENANT_ID_2=your_graph_tenant_id_2
GRAPH_TENANT_2_DOMAINS=filefuze.co

# ─── Outlook accounts (comma-separated emails connected via Graph) ─────────────
OUTLOOK_ACCOUNTS=admin@yourdomain.com,user@yourdomain.com

# ─── CloudFuze Migration API ──────────────────────────────────────────────────
# Base URL (no trailing slash). E.g. https://s2cdev.cloudfuze.com/proxyservices/v1
MIGRATION_API_URL=https://devemail.cloudfuze.com/proxyservices/v1
# Base64(userId:apiSecret) — copy from DevTools → Network → any API request → Authorization header
MIGRATION_API_BASIC_AUTH=your_base64_user_id_and_api_secret
# Fallback login credentials (used when MIGRATION_API_BASIC_AUTH is not set)
MIGRATION_API_USERNAME=your_email@cloudfuze.com
MIGRATION_API_PASSWORD=your_cloudfuze_password
CLOUDFUZE_OWNER_EMAIL=your_admin@cloudfuze.com
# Set true to skip GET /users/validateUser
CLOUDFUZE_SKIP_VALIDATE_USER=false
# Set true to allow self-signed / IP HTTPS (lab only)
MIGRATION_API_TLS_INSECURE=false
# Max minutes MigrationAgent polls for email migration completion (default 30)
MIGRATION_MAX_WAIT_MINUTES=30
# 0 = return immediately after CF chat initiation (no blocking destination poll)
CHAT_MIGRATION_MAX_WAIT_MINUTES=0

# ─── Scheduler ────────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=false
DEFAULT_SOURCE_EMAIL=source@example.com
DEFAULT_DEST_EMAIL=dest@example.com

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Jira + Xray (Server / Data Center) ──────────────────────────────────────
JIRA_BASE_URL=https://your-jira.example.com
JIRA_USER=you@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=TEST
# true = fetch full test steps during import (slower but richer offline data)
TEST_REPOSITORY_IMPORT_EXPANDED=true
# true = fall back to live Xray + Jira REST when offline detail is missing
TEST_REPOSITORY_TEST_DETAIL_LIVE_FALLBACK=true

# ─── Xray Cloud ───────────────────────────────────────────────────────────────
# Jira: Settings → Apps → Xray → Global Settings → API Keys → Create API Key
XRAY_CLIENT_ID=your_xray_client_id
XRAY_CLIENT_SECRET=your_xray_client_secret
# Xray GraphQL per-request timeout (ms). 0 = no timeout.
XRAY_GRAPHQL_TIMEOUT_MS=0

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Atlas → Connect → Drivers → copy connection string (URL-encode special chars in password)
MONGODB_URI=mongodb+srv://db_user:your_password@cluster0.mongodb.net/?authSource=admin&retryWrites=true&w=majority
# Optional fallback URI if srv DNS fails
MONGODB_URI_FALLBACK=mongodb://db_user:your_password@shard-00-00.mongodb.net:27017,.../?authSource=admin&tls=true

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# ─── Bulk Calendar API ────────────────────────────────────────────────────────
BULK_CALENDAR_API_URL=http://localhost:8080

# ─── Slack (Message Agent — OAuth) ───────────────────────────────────────────
# Create Slack app: https://api.slack.com/apps → OAuth & Permissions
# Redirect URL: http://localhost:5000/api/auth/slack/callback
# Required scopes: users:read, users:read.email, channels:read, groups:read, chat:write
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
# Optional: pre-issued user token (xoxp-…) — auto-loaded on startup, skips OAuth popup
# SLACK_USER_TOKEN=xoxp-your_slack_user_token_here
