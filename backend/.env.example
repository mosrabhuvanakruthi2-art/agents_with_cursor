# Server
PORT=5000

# Google OAuth2 (shared client credentials) — cloudfuze.us accounts
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google OAuth2 — second tenant (storefuze.com / Zara@storefuze.com)
GOOGLE_CLIENT_ID_2=your-google-client-id-2.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET_2=your-google-client-secret-2

# Google OAuth2 — third tenant (migrationn.com / admin@migrationn.com)
GOOGLE_CLIENT_ID_3=your-google-client-id-3.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET_3=your-google-client-secret-3

# Google accounts: email=refreshToken (comma-separated pairs)
# Format: email1=token1,email2=token2,...
GOOGLE_ACCOUNTS=user@domain.com=refresh_token_here

# Microsoft Graph / Azure AD — first tenant (gajha.com)
GRAPH_CLIENT_ID=your-graph-client-id
GRAPH_CLIENT_SECRET=your-graph-client-secret
GRAPH_TENANT_ID=your-graph-tenant-id

# Microsoft Graph / Azure AD — second tenant (filefuze.co / erik@filefuze.co)
GRAPH_CLIENT_ID_2=your-graph-client-id-2
GRAPH_CLIENT_SECRET_2=your-graph-client-secret-2
GRAPH_TENANT_ID_2=your-graph-tenant-id-2
# Comma-separated email domains that belong to the second Microsoft tenant
GRAPH_TENANT_2_DOMAINS=filefuze.co,qatestagent.com

# Comma-separated email domains that belong to the second Google tenant (storefuze.com)
GOOGLE_TENANT_2_DOMAINS=storefuze.com
# Service account JSON key path for tenant 2 (used for Domain-Wide Delegation — no per-user OAuth needed)
GOOGLE_SERVICE_ACCOUNT_KEY_2=./config/gem-co-service-account.json
# Known users for storefuze.com — used by GmailTestDataAgent as correspondents/inbound senders
GOOGLE_TENANT_2_KNOWN_USERS=zara@storefuze.com
# Comma-separated email domains that belong to the third Google tenant (migrationn.com)
GOOGLE_TENANT_3_DOMAINS=migrationn.com
# Known users for migrationn.com — used by GmailTestDataAgent as correspondents/inbound senders
GOOGLE_TENANT_3_KNOWN_USERS=admin@migrationn.com,alex@migrationn.com,ben@migrationn.com,dan@migrationn.com,ron@migrationn.com
# Service account JSON key path for tenant 3 (used for Domain-Wide Delegation — no per-user OAuth needed)
GOOGLE_SERVICE_ACCOUNT_KEY_3=./config/google-service-account-migrationn.json

# Outlook accounts (comma-separated emails)
# Format: email1,email2,email3,...
OUTLOOK_ACCOUNTS=user1@domain.com,user2@domain.com

# CloudFuze Migration API
MIGRATION_API_URL=https://devemail.cloudfuze.com/proxyservices/v1
MIGRATION_API_KEY=your-migration-api-key-base64
CLOUDFUZE_OWNER_EMAIL=owner@yourdomain.com
CLOUDFUZE_SKIP_VALIDATE_USER=true
# Admin email that owns the SOURCE cloud in CloudFuze (shown in /mail/clouds list)
CLOUDFUZE_SOURCE_ADMIN_EMAIL=source-admin@domain.com
# Admin email that owns the DESTINATION cloud in CloudFuze (shown in /mail/clouds list)
CLOUDFUZE_DEST_ADMIN_EMAIL=dest-admin@domain.com
# Direct cloud IDs — bypass GET /mail/clouds entirely (get from DevTools → /mail/clouds response → id field)
CLOUDFUZE_SOURCE_CLOUD_ID=your-source-cloud-id
CLOUDFUZE_DEST_CLOUD_ID=your-dest-cloud-id
# Direction-aware IDs — use these instead of SOURCE/DEST so both Gmail→Outlook and Outlook→Gmail work automatically
CLOUDFUZE_GMAIL_CLOUD_ID=your-gmail-cloud-id
CLOUDFUZE_OUTLOOK_CLOUD_ID=your-outlook-cloud-id
# Cross-domain user email mappings — pairs for address rewriting
USER_EMAIL_MAPPINGS=user1@source.com:user1@dest.com,user2@source.com:user2@dest.com
MIGRATION_API_BASIC_AUTH=your-basic-auth-token-base64
# Bearer JWT — used for /mail/reports status polling. Expires ~12h.
# Agent auto-refreshes via POST /mail/register (Basic auth) at start of each run — manual paste only needed as fallback.
MIGRATION_API_BEARER_TOKEN=your-bearer-jwt-token
# Max minutes to poll destination for migration completion (default 30)
MIGRATION_MAX_WAIT_MINUTES=30

# Scheduler
SCHEDULER_ENABLED=false
DEFAULT_SOURCE_EMAIL=source@example.com
DEFAULT_DEST_EMAIL=dest@example.com

# Logging
LOG_LEVEL=info

# Jira + Xray (API base = site root, not /jira)
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_USER=your-jira-email@domain.com
JIRA_API_TOKEN=your-jira-api-token
# Default project for Test Repository import (override in UI if needed)
JIRA_PROJECT_KEY=TEST
# true = fetch full step data per test during import and cache in MongoDB test_expanded_details
TEST_REPOSITORY_IMPORT_EXPANDED=true
# true = fall back to live Xray for test-detail modal when MongoDB cache misses
TEST_REPOSITORY_TEST_DETAIL_LIVE_FALLBACK=true

# Xray Cloud — Jira: Apps → Xray → Global Settings → API Keys (required for Test Repository import on Cloud)
XRAY_CLIENT_ID=your-xray-client-id
XRAY_CLIENT_SECRET=your-xray-client-secret
# 0 = no per-request Axios timeout on Xray GraphQL (waits for slow getTests). Or set ms cap e.g. 3600000 (1h).
XRAY_GRAPHQL_TIMEOUT_MS=0

# Atlas — TLS "internal error" / alert 80: add your current IP in Atlas → Network Access (required if blocked).
# Primary = standard replica hosts (no SRV). If npm start fails with querySrv/ECONNREFUSED, leave FALLBACK commented — your PC/DNS cannot resolve mongodb+srv SRV records.
# Optional fallback (uncomment only if SRV DNS works): mongodb+srv://…@cluster0….mongodb.net/…
# Lab-only SSL inspection: MONGODB_TLS_INSECURE=true
OPENAI_API_KEY=your-openai-api-key
MONGODB_URI=mongodb://db_user:db_password@host1:27017,host2:27017,host3:27017/?authSource=admin&tls=true&retryWrites=true&w=majority
MONGODB_URI_FALLBACK=mongodb+srv://db_user:db_password@cluster0.yourcluster.mongodb.net/?authSource=admin&retryWrites=true&w=majority&appName=Cluster0

# Box OAuth 2.0 (Standard OAuth 2.0 app)
BOX_CLIENT_ID=your-box-client-id
BOX_CLIENT_SECRET=your-box-client-secret

# Bulk Calendar API (for primary calendar event count + delete)
BULK_CALENDAR_API_URL=http://localhost:8080
