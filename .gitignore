# Dependencies
node_modules/

# Secrets — use .env.example only in git
# .env.* also covers backups (.env.bak-*, .env.old) — these hold real credentials
.env
**/.env
.env.*
**/.env.*
!.env.example
!**/.env.example

# Service-account keys / credential JSON — never commit
backend/config/
**/*service-account*.json
**/*-credentials.json

# Build / logs
frontend/dist/
backend/logs/*
!backend/logs/.gitkeep
*.log

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Runtime / sensitive data
backend/data/oauth-tokens.json
backend/data/executions.json
backend/data/custom-test-cases.json
backend/data/test-repository.json
backend/data/channel-cache.json

# Claude IDE config
# settings.json is SHARED — it carries the GStack enforcement hooks the whole team needs.
# Only personal preferences (settings.local.json) stay out of git.
.claude/settings.local.json
.claude/scheduled_tasks.lock
backend/config/gem-co-service-account.json
backend/config/*.json
