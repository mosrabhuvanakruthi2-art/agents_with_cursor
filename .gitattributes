# Normalize line endings to LF on commit — prevents CRLF/LF merge conflicts
# when developers push from Windows and other machines.
* text=auto eol=lf

# Explicit text files
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.html text eol=lf

# Binary files — never normalize
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.svg  text eol=lf
*.pdf  binary
*.xlsx binary
*.ico  binary
