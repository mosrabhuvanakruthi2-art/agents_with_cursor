# Server
PORT=5000

# Google OAuth2 (shared client credentials) — cloudfuze.us accounts
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Google OAuth2 — second tenant (storefuze.com)
GOOGLE_CLIENT_ID_2=YOUR_GOOGLE_CLIENT_ID_2
GOOGLE_CLIENT_SECRET_2=YOUR_GOOGLE_CLIENT_SECRET_2

# Google OAuth2 — third tenant (migrationn.com)
GOOGLE_CLIENT_ID_3=YOUR_GOOGLE_CLIENT_ID_3
GOOGLE_CLIENT_SECRET_3=YOUR_GOOGLE_CLIENT_SECRET_3

# Google accounts: email=refreshToken (comma-separated pairs)
# Format: email1=token1,email2=token2,...
GOOGLE_ACCOUNTS=user1@example.com=YOUR_REFRESH_TOKEN_1,user2@example.com=YOUR_REFRESH_TOKEN_2

# Microsoft Graph / Azure AD — first tenant (gajha.com)
GRAPH_CLIENT_ID=YOUR_GRAPH_CLIENT_ID
GRAPH_CLIENT_SECRET=YOUR_GRAPH_CLIENT_SECRET
GRAPH_TENANT_ID=YOUR_GRAPH_TENANT_ID

# Microsoft Graph / Azure AD — second tenant (filefuze.co / qatestagent.com)
GRAPH_CLIENT_ID_2=YOUR_GRAPH_CLIENT_ID_2
GRAPH_CLIENT_SECRET_2=YOUR_GRAPH_CLIENT_SECRET_2
GRAPH_TENANT_ID_2=YOUR_GRAPH_TENANT_ID_2
# Comma-separated email domains that belong to the second Microsoft tenant
GRAPH_TENANT_2_DOMAINS=filefuze.co,qatestagent.com

# Comma-separated email domains that belong to the second Google tenant (storefuze.com)
GOOGLE_TENANT_2_DOMAINS=storefuze.com
# Service account JSON key path for tenant 2 (used for Domain-Wide Delegation — no per-user OAuth needed)
GOOGLE_SERVICE_ACCOUNT_KEY_2=./config/gem-co-service-account.json
# Known users for storefuze.com — used by GmailTestDataAgent as correspondents/inbound senders
GOOGLE_TENANT_2_KNOWN_USERS=zara@storefuze.com
# Comma-separated email domains that belong to the third Google tenant (migrationn.com)
GOOGLE_TENANT_3_DOMAINS=migrationn.com
# Known users for migrationn.com — used by GmailTestDataAgent as correspondents/inbound senders
GOOGLE_TENANT_3_KNOWN_USERS=admin@migrationn.com,alex@migrationn.com,ben@migrationn.com,dan@migrationn.com,ron@migrationn.com
# Service account JSON key path for tenant 3 (used for Domain-Wide Delegation — no per-user OAuth needed)
GOOGLE_SERVICE_ACCOUNT_KEY_3=./config/google-service-account-migrationn.json

# Outlook accounts (comma-separated emails)
OUTLOOK_ACCOUNTS=user1@domain.com,user2@domain.com

# Pre-provisioned M365 shared mailbox address (created once in Admin Center; Graph cannot create one).
# When set, E2E seeding puts real content into this shared mailbox and uses it as the real sender for
# the shared-mailbox test case. Leave empty to fall back to a From-header simulation.
SHARED_MAILBOX_ADDRESS=

# CloudFuze Migration API
MIGRATION_API_URL=https://devemail.cloudfuze.com/proxyservices/v1
MIGRATION_API_KEY=YOUR_MIGRATION_API_KEY_BASE64
CLOUDFUZE_OWNER_EMAIL=owner@cloudfuze.com
CLOUDFUZE_SKIP_VALIDATE_USER=true
# Admin email that owns the SOURCE cloud in CloudFuze (shown in /mail/clouds list)
CLOUDFUZE_SOURCE_ADMIN_EMAIL=source-admin@example.com
# Admin email that owns the DESTINATION cloud in CloudFuze (shown in /mail/clouds list)
CLOUDFUZE_DEST_ADMIN_EMAIL=dest-admin@example.com
# Direct cloud IDs — bypass GET /mail/clouds entirely (get from DevTools → /mail/clouds response → id field)
CLOUDFUZE_SOURCE_CLOUD_ID=YOUR_SOURCE_CLOUD_ID
CLOUDFUZE_DEST_CLOUD_ID=YOUR_DEST_CLOUD_ID
# Direction-aware IDs — use these instead of SOURCE/DEST so both Gmail→Outlook and Outlook→Gmail work automatically
CLOUDFUZE_GMAIL_CLOUD_ID=YOUR_GMAIL_CLOUD_ID
CLOUDFUZE_OUTLOOK_CLOUD_ID=YOUR_OUTLOOK_CLOUD_ID
# Cross-domain user email mappings
USER_EMAIL_MAPPINGS=source1@domain.com:dest1@domain.com,source2@domain.com:dest2@domain.com
MIGRATION_API_BASIC_AUTH=YOUR_BASIC_AUTH_BASE64
# Bearer JWT — used for /mail/reports status polling. Expires ~12h.
MIGRATION_API_BEARER_TOKEN=YOUR_BEARER_TOKEN
# Max minutes to poll destination for migration completion (default 30)
MIGRATION_MAX_WAIT_MINUTES=30

# Scheduler
SCHEDULER_ENABLED=false
DEFAULT_SOURCE_EMAIL=source@example.com
DEFAULT_DEST_EMAIL=dest@example.com

# Logging
LOG_LEVEL=info

# Jira + Xray (API base = site root, not /jira)
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_USER=your-email@cloudfuze.com
JIRA_API_TOKEN=YOUR_JIRA_API_TOKEN
# Default project for Test Repository import (override in UI if needed)
JIRA_PROJECT_KEY=TEST
# true = fetch full step data per test during import and cache in MongoDB test_expanded_details
TEST_REPOSITORY_IMPORT_EXPANDED=true
# true = fall back to live Xray for test-detail modal when MongoDB cache misses
TEST_REPOSITORY_TEST_DETAIL_LIVE_FALLBACK=true

# Xray Cloud — Jira: Apps → Xray → Global Settings → API Keys
XRAY_CLIENT_ID=YOUR_XRAY_CLIENT_ID
XRAY_CLIENT_SECRET=YOUR_XRAY_CLIENT_SECRET
# 0 = no per-request Axios timeout on Xray GraphQL. Or set ms cap e.g. 3600000 (1h).
XRAY_GRAPHQL_TIMEOUT_MS=0

# MongoDB
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
MONGODB_URI=YOUR_MONGODB_URI
MONGODB_URI_FALLBACK=YOUR_MONGODB_URI_FALLBACK
MONGODB_DB_NAME=migration_qa

# Bulk Calendar API (for primary calendar event count + delete)
BULK_CALENDAR_API_URL=http://localhost:8080

# Box Cloud
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_DEVELOPER_TOKEN=

# ── Content: deep validation (files/folders source↔destination comparison) ──────
# Feature reference: backend/data/feature-scope/google-shared-drive-to-sharepoint-*.md
# Master switch. 'false' leaves content runs report-only (no comparison at all).
ENABLE_DEEP_CONTENT_VALIDATION=true
# Tier C — permissions, shared links, versions, timestamps.
CONTENT_DEEP_VALIDATE_METADATA=true
CONTENT_DEEP_VALIDATE_LINKS=true
# Tier B — SHA-256 of file bytes. Two full downloads per file, so off by default.
CONTENT_DEEP_VALIDATE_FILE_HASH=false
# Cap on files hashed per run when Tier B is on.
DEEP_CONTENT_MAX_FILES=500
# Features 9.1/9.2 — assert the destination mailbox received no SharePoint sharing mail.
# Needs mailbox access for the destination user.
CONTENT_DEEP_VALIDATE_NOTIFICATIONS=false
# Declares that the MIGRATION JOB asked CloudFuze to suppress destination email.
# Features 9.1/9.2 compare the destination mailbox; the combination document states that without
# suppression "users receive standard SharePoint sharing notifications", so mail is the correct
# outcome then and must not be failed. Leave unset until the job actually enables suppression —
# the features report as not exercised instead of passing or failing on no evidence.
CONTENT_MIGRATION_SUPPRESSES_NOTIFICATIONS=false

# Destination SharePoint target for content validation.
SHAREPOINT_HOSTNAME=YOUR_TENANT.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/YOUR_SITE
# Name of the Google Shared Drive holding the source test data.
GOOGLE_SHARED_DRIVE_NAME=YOUR_SHARED_DRIVE_NAME
# Extra grantees for the content permission matrix. Group grants and external shares are the
# dimensions the manual QA suite exercises most; blank means "not exercised" in the report.
# Principals the permission matrix grants access to (in-scope features 4.2-4.8 and 4.9).
# With any of these blank the matching cases are SKIPPED and the features report NA rather than
# failing, which reads as "not tested" and is easy to miss.
#   EDITOR/VIEWER must already appear in the run's user mapping, so CloudFuze has a destination
#   principal to re-grant to. Some accounts cannot hold `commenter` (Google: "lack the necessary
#   license"), so prefer a licensed account for EDITOR.
#   GROUP must be a Google Group; a group that already has access to the drive works.
#   EXTERNAL must be outside the source domain for feature 4.9 to mean anything.
# Set to "blocked" only after verifying the destination site refuses anonymous sharing (Graph
# createLink scope=anonymous returns "sharing has been disabled on this site"). Missing anonymous
# links are then reported as expected rather than as failures, per the combination document.
# Extra source->destination principal pairs added to EVERY run, as "source:dest,source:dest".
# The run wizard can only map principals it fetched as mailboxes, so groups, shared mailboxes and
# distribution lists cannot be mapped there. Without a destination principal their permissions
# are out of scope and the report says so. Caller-supplied pairs always win over these.
#   e.g. qa-group-view@your.domain:viewer@dest.domain,qa-group-edit@your.domain:editor@dest.domain
CONTENT_EXTRA_USER_MAPPINGS=

CONTENT_DEST_ANONYMOUS_SHARING=

GOOGLE_TEST_EDITOR_EMAIL=YOUR_EDITOR_USER@YOUR_DOMAIN
GOOGLE_TEST_VIEWER_EMAIL=YOUR_VIEWER_USER@YOUR_DOMAIN
GOOGLE_TEST_GROUP_EMAIL=YOUR_TEST_GROUP@YOUR_DOMAIN
GOOGLE_TEST_EXTERNAL_EMAIL=YOUR_EXTERNAL_USER@OTHER_DOMAIN

# ── CloudFuze path-CSV mapping (content migrations) ──────────────────────────
# The path-CSV validation step is what resolves each mapping row's pathRootFolderId. If it has not
# finished when we stop polling, the job is created against an UNRESOLVED mapping (mapped=false) and
# CloudFuze scans only the root folder itself — one item — instead of descending into it. The
# defaults below (60 polls x 5s = 5 minutes) replace an earlier 15 x 4s = 60s ceiling that was
# timing out on every Google Shared Drive run. Raise if the log still reports "did not report ready".
CONTENT_CSV_VALIDATION_POLL_MS=5000
CONTENT_CSV_VALIDATION_MAX_POLLS=60
