# Analytics — Hotjar
#
# Hotjar Site ID, digits only. Blank disables Hotjar entirely (no script requested, no session
# recorded). NOT a secret: it ships inside client-side JavaScript that any visitor can read, so it
# belongs in a plain variable, not a secret store.
#
# Vite freezes this into the bundle at `npm run build` time. To change it without rebuilding, edit
# `hotjarSiteId` in public/runtime-config.js on the server instead — that wins over this value.
VITE_HOTJAR_SITE_ID=6766428
